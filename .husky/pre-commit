#!/usr/bin/env sh

# Gate every commit on the two checks that are fast enough to run here.
# `next build` is deliberately left to CI — it is far too slow for a hook.

# 1. Biome, scoped to the files actually staged. Formatting is not auto-applied:
#    rewriting files mid-commit would leave the staged copy and the working copy
#    disagreeing. Fix and re-stage instead.
echo "husky: biome check (staged)"
if ! bunx biome check --staged --no-errors-on-unmatched; then
  echo ""
  echo "husky: biome found problems in staged files."
  echo "       run 'bun run check' to auto-fix, then re-stage."
  exit 1
fi

# 2. TypeScript. Whole-project, because a change in one file can break the types
#    in another — checking only staged files would miss exactly that.
echo "husky: typecheck"
if ! bun run typecheck; then
  echo ""
  echo "husky: TypeScript errors. fix them before committing."
  exit 1
fi
