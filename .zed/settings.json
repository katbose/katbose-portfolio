{
  "context_servers": {
    "mintlify-admin": {
      "url": "https://mcp.mintlify.com"
    },
    "mintlify-search": {
      "url": "https://mintlify.com/docs/mcp"
    },
    "socket-mcp": {
      "url": "https://mcp.socket.dev/"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--isolated",
        "--headless",
        "--browser",
        "chrome"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@4.21.0",
        "mcp"
      ]
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
