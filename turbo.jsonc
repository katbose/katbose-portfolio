{
  // Turborepo orchestrates the workspace-aware tasks only.
  //
  // Biome is deliberately NOT a turbo task. It already scans the whole repo in
  // one fast pass and covers root-level files (workflows, configs, this file)
  // that a per-workspace run would never see. Splitting it per app would be
  // slower AND less thorough. Root scripts call it directly instead.
  "tasks": {
    "build": {
      "description": "Production build for a workspace.",
      // Wait for dependency packages to build first, so a future shared
      // library is compiled before the app that imports it.
      "dependsOn": ["^build"],
      "env": ["VERCEL"],
      // Next writes into .next; its cache and dev dirs must stay out of the
      // Turborepo artifact or the cache balloons and replays go stale.
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },

    "typecheck": {
      "description": "tsc --noEmit across a workspace.",
      "dependsOn": ["^typecheck"]
    },

    "test": {
      "description": "Fast unit tests (Bun). No build required.",
      "dependsOn": ["^test"]
    },

    "test:e2e": {
      "description": "Playwright browser suite.",
      // Same-package dependency, NOT "^build": playwright.config.ts starts the
      // server with `bun run start`, which serves this workspace's own .next
      // output. Without this the suite fails with "no production build found".
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },

    "validate": {
      "description": "Content/config validation for a workspace (e.g. Mintlify docs)."
    },

    "dev": {
      "description": "Dev servers: web on :7000, docs on :7003.",
      // A dev server never exits. `persistent` tells Turborepo that, so it
      // keeps the task running instead of waiting for it, and refuses to let
      // any other task declare a dependency on it.
      "persistent": true,
      // Watch output is never a reusable artifact, and replaying a cached dev
      // server would be actively wrong. No `outputs` either, for the same
      // reason.
      "cache": false
      // Deliberately NOT "interactive": true. It would let the TUI forward
      // keystrokes to a focused server, but Turborepo then refuses to start the
      // task at all unless the TUI is active — so `bun run dev` would die with
      // "Cannot run interactive task without Terminal UI" any time output is
      // piped or the shell is not a TTY. Neither dev server needs stdin.
    }
  }
}
