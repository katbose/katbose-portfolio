# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (per-workspace in the monorepo, so NOT anchored to the root —
# bun installs a nested apps/web/node_modules alongside the hoisted root one)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (per-workspace in the monorepo, so these are not anchored to the root)
.next/
out/

# production (per-workspace, so not anchored to the root)
build/

# misc
.DS_Store
*.pem

# personal documents. A CV carries a phone number and a personal email address,
# and this repository is public — anything committed here stays in git history
# even after the file is deleted. Kept deliberately broad so a stray copy or an
# exported variant cannot slip through.
*.pdf
*.docx
*.tex
*[Rr]esume*
*[Rr][Ee][Ss][Uu][Mm][Ee]*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Visual regression baselines are platform-specific (font rasterization differs
# between Windows/Linux/macOS). Committing them causes CI failures when the
# runner's OS doesn't match the dev machine. Generate locally for manual review,
# but exclude from version control.
**/*-snapshots/

# AI agent documentation — local reference only, not committed to repository.
# Contains modernization plans, handoff guides, and implementation checklists
# for AI agents working on the codebase.
.ai-docs/
/apps/web/MODERNIZATION.md

# turborepo
.turbo/

# mintlify cli (local preview cache + generated artifacts)
.mint/
.mintlify/

# lefthook personal overrides. lefthook merges any `lefthook-local.*` on top of
# lefthook.yml; it exists so one person can tweak or skip hooks locally, so
# committing it would defeat the point.
lefthook-local.yml
lefthook-local.yaml
lefthook-local.json
lefthook-local.toml
.lefthook-local.yml
.lefthook-local.yaml

# opencode workspace. Skills, plugins, and local agent settings installed here
# are machine-local workflow, not project source — the same reason .ai-docs/
# stays untracked. Root opencode.json (the generated MCP mirror) stays tracked.
.opencode/
