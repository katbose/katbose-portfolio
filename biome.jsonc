{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `!dir/**/*` is the form that both excludes the contents and satisfies
    // biome's own useBiomeIgnoreFolder rule (`!dir/` does not actually exclude).
    //
    // Biome runs once from the repo root for the whole monorepo rather than
    // per-workspace, so it also covers root-level files a per-app run would miss.
    "includes": [
      "**",
      "!bun.lock",
      "!apps/*/public/**/*",
      "!apps/*/.next/**/*",
      "!apps/*/test-results/**/*",
      "!apps/*/playwright-report/**/*",
      // Generated by scripts/sync-mcp.mjs from .kiro/settings/mcp.json. The
      // generator's own JSON.stringify formatting is the source of truth;
      // biome's array-collapsing would fight it on every run and make
      // `mcp:check` fail right after `bun run check` passes.
      "!.mcp.json",
      "!opencode.json",
      "!.vscode/mcp.json"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Every list in this project is rendered from the static `portfolio.json`
        // content file, in file order. Nothing reorders, filters, or mutates at
        // runtime, which is the case React itself sanctions index keys for.
        // Content-derived keys would collide on repeated prose (the essays contain
        // one-line paragraphs), so the index is the safer key here.
        "noArrayIndexKey": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
